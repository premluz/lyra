{
  "name": "lyra",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests *.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@magenta/music": "1.23.1",
    "@tensorflow/tfjs": "2.8.6",
    "@tonaljs/rhythm-pattern": "1.0.0",
    "three": "0.186.1"
  },
  "overrides": {
    "@magenta/music": {
      "@types/webgl2": "0.0.12",
      "protobufjs": "8.8.1",
      "minimist": "1.2.8",
      "static-eval": "2.1.1",
      "static-module": "3.0.4",
      "sprintf-js": "1.1.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
