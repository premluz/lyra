{
  "name": "particle-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --config vite.embed.config.ts && vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --config vite.embed.config.ts && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint src tests scripts *.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual": "playwright test tests/visual.spec.ts",
    "verify": "npm run lint && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@magenta/music": "1.23.1",
    "@tonaljs/rhythm-pattern": "1.0.0",
    "gsap": "3.15.0",
    "jszip": "3.10.2",
    "lucide-react": "1.50.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1"
  },
  "overrides": {
    "@magenta/music": {
      "@types/webgl2": "0.0.12",
      "protobufjs": "8.8.1",
      "minimist": "1.2.8",
      "static-eval": "2.1.1",
      "static-module": "3.0.4",
      "sprintf-js": "1.1.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
